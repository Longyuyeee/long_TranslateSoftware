{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Long翻译",
  "version": "0.5.0",
  "identifier": "com.long.translate",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Long翻译 · 智能助手",
        "width": 1000,
        "height": 700,
        "minWidth": 820,
        "minHeight": 560,
        "visible": false,
        "resizable": true
      },
      {
        "label": "floating",
        "title": "AI Translation",
        "width": 420,
        "height": 300,
        "minWidth": 320,
        "minHeight": 240,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "resizable": true,
        "shadow": true
      },
      {
        "label": "ocr-overlay",
        "title": "OCR Selection",
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "x": 0,
        "y": 0,
        "width": 1920,
        "height": 1080
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": ["zh-CN"],
        "fragmentPaths": ["./windows/native-host.wxs"]
      },
      "nsis": {
        "installerHooks": "./windows/native-host-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI5MDYzM0VFODYyODc0QzIKUldUQ2RDaUc3ak1HdVNaTzdjTjVheG1PTDFPZ2xrUkdSdnFlMHI4a0FxZXJSNVVMV2V1cC9oZUQK",
      "endpoints": [
        "https://github.com/Longyuyeee/long_TranslateSoftware/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

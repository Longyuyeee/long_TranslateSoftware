{
  "manifest_version": 3,
  "name": "Long Translate Bridge (Development)",
  "version": "0.1.0",
  "description": "Translates selected page text through the local Long Translate desktop app.",
  "key": "",
  "permissions": ["nativeMessaging", "activeTab", "scripting"],
  "background": {
    "service_worker": "assets/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Long Translate Bridge",
    "default_popup": "popup.html"
  }
}
